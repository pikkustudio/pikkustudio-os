    "check:independence": "node scripts/check-independence.mjs"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.184",
    "@types/node": "^24",
    "oxlint": "^1.78.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.1",
  "overrides": {
    "typescript": "^6.0.3"
  }
}
