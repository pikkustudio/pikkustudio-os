{
  "name": "@pikkustudio/os",
  "version": "0.0.1",
  "license": "BUSL-1.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/addons/*"
  ],
  "scripts": {
