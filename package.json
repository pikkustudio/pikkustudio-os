{
  "name": "@pikkustudio/os",
  "version": "0.0.1",
  "license": "BUSL-1.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/addons/*",
    "!packages/pikkustudio-private"
  ],
  "scripts": {
    "prebuild": "node scripts/build-libs.mjs && cd packages/functions && bunx --bun pikku all $(node ../../scripts/pikku-config.mjs) && cd ../../apps/studio && node ../../scripts/gen-addons.mjs && node ../../scripts/gen-routes.mjs && node ../../scripts/check-links.mjs && bunx --bun paraglide-js compile --project $(node ../../scripts/inlang-project.mjs) --outdir ./src/paraglide",
    "build": "bun run --filter '*' --if-present build",
    "dev": "bun run --filter @pikkustudio/app-studio dev",
    "tsc": "bun run --filter '*' --if-present tsc",
    "test": "bun run --filter '*' --if-present test",
    "lint": "oxlint apps packages",
    "check:cloud-boundary": "node scripts/check-cloud-boundary.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "build:desktop": "bash scripts/build-desktop.sh",
    "build:hosted": "bash scripts/build-hosted.sh",
    "dev:hosted": "bash scripts/dev-hosted.sh"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.198",
    "@pikku/deploy-standalone": "^0.12.29",
    "@types/bun": "^1.4.3",
    "@types/node": "^24",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.78.0",
    "puppeteer-core": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.1",
  "overrides": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.81",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@better-auth/oauth-provider": "^1.7.11",
    "@pikku/addon-console": "^0.12.65",
    "@pikku/ai-vercel": "^0.12.16",
    "@pikku/better-auth": "^0.12.59",
    "@pikku/bun-server": "^0.12.15",
    "@pikku/core": "^0.12.148",
    "@pikku/fetch": "^0.12.13",
    "@pikku/kysely": "^0.13.40",
    "@pikku/kysely-bun-sqlite": "^0.12.11",
    "@pikku/modelcontextprotocol": "^0.12.19",
    "@pikku/react": "^0.12.17",
    "@pikku/schedule": "^0.12.11",
    "@pikku/schema-cfworker": "^0.12.9",
    "ai": "^7.0.122",
    "better-auth": "^1.7.11",
    "sqlite-vec": "^0.1.9"
  }
}
