{
  "name": "@pikkustudio/os",
  "version": "0.0.1",
  "license": "BUSL-1.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/addons/*"
  ],
  "scripts": {
    "prebuild": "node scripts/build-libs.mjs && cd packages/functions && bunx --bun pikku all && cd ../../apps/studio && bunx --bun paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "build": "bun run --filter '*' --if-present build",
    "dev": "bun scripts/dev.mjs",
    "tsc": "bun run --filter '*' --if-present tsc",
    "test": "bun run --filter '*' --if-present test",
    "lint": "oxlint apps packages",
    "check:fabric-boundary": "node scripts/check-fabric-boundary.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "build:desktop": "bash scripts/build-desktop.sh"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.184",
    "@pikku/deploy-standalone": "^0.12.25",
    "@types/bun": "^1.4.3",
    "@types/node": "^24",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.78.0",
    "puppeteer-core": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.1",
  "overrides": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.81",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@pikku/addon-console": "^0.12.59",
    "@pikku/ai-vercel": "^0.12.15",
    "@pikku/assistant-ui": "^0.12.13",
    "@pikku/better-auth": "^0.12.54",
    "@pikku/bun-server": "^0.12.13",
    "@pikku/core": "^0.12.141",
    "@pikku/fetch": "^0.12.12",
    "@pikku/kysely": "^0.13.35",
    "@pikku/kysely-bun-sqlite": "^0.12.10",
    "@pikku/kysely-node-sqlite": "^0.12.9",
    "@pikku/kysely-sqlite": "^0.12.17",
    "@pikku/react": "^0.12.15",
    "@pikku/schedule": "^0.12.9",
    "@pikku/schema-cfworker": "^0.12.8",
    "ai": "^7.0.122",
    "better-auth": "^1.7.6",
    "sqlite-vec": "^0.1.9"
  }
}
