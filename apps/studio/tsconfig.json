{
  "typeAcquisition": { "enable": false },
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
    // One copy of each, so linked packages (wt-design) do not load their own and get checked again.
      "kysely": ["../../node_modules/kysely"],
      "kysely/*": ["../../node_modules/kysely/*"],
      "zod": ["../../node_modules/zod"],
      "zod/*": ["../../node_modules/zod/*"],
      "nanostores": ["../../node_modules/nanostores"],
      "nanostores/*": ["../../node_modules/nanostores/*"],
      "jose": ["../../node_modules/jose"],
      "jose/*": ["../../node_modules/jose/*"],
      "csstype": ["../../node_modules/csstype"],
      "csstype/*": ["../../node_modules/csstype/*"],
      "better-call": ["../../node_modules/better-call"],
      "better-call/*": ["../../node_modules/better-call/*"],
      "better-auth": ["../../node_modules/better-auth"],
      "better-auth/*": ["../../node_modules/better-auth/*"],
      "@standard-schema/spec": ["../../node_modules/@standard-schema/spec"],
      "@standard-schema/spec/*": ["../../node_modules/@standard-schema/spec/*"],
      "@better-fetch/fetch": ["../../node_modules/@better-fetch/fetch"],
      "@better-fetch/fetch/*": ["../../node_modules/@better-fetch/fetch/*"],
      "@better-auth/utils": ["../../node_modules/@better-auth/utils"],
      "@better-auth/utils/*": ["../../node_modules/@better-auth/utils/*"],
      "@better-auth/telemetry": ["../../node_modules/@better-auth/telemetry"],
      "@better-auth/telemetry/*": ["../../node_modules/@better-auth/telemetry/*"],
      "@better-auth/core": ["../../node_modules/@better-auth/core"],
      "@better-auth/core/*": ["../../node_modules/@better-auth/core/*"],
      "react": ["../../node_modules/@types/react"],
      "react/*": ["../../node_modules/@types/react/*"]
    }
  },
  "include": ["src", "build", "vite.config.ts"]
}
