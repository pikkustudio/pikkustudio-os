{
  "name": "@pikkustudio/addon-studio",
  "version": "0.0.1",
  "description": "Studio addon for Pikku — the local backend behind Pikku Studio",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": "./dist/.pikku/*/index.js"
  },
  "exports": {
    ".": "./dist/.pikku/addon/pikku-bootstrap.gen.js",
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/addon/pikku-metadata.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/addon/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    },
    "./services": {
      "types": "./dist/src/services/studio.d.ts",
      "import": "./dist/src/services/studio.js",
      "default": "./dist/src/services/studio.js"
    },
    "./sources": {
      "types": "./dist/src/sources.d.ts",
      "import": "./dist/src/sources.js",
      "default": "./dist/src/sources.js"
    },
    "./contributors": {
      "types": "./dist/src/contributors.d.ts",
      "import": "./dist/src/contributors.js",
      "default": "./dist/src/contributors.js"
    }
  },
  "pikku": {
    "contributors": [
      {
        "module": "@pikkustudio/addon-studio/contributors",
        "export": "studioSources"
      }
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && pikku all && tsc && (cp .pikku/addon/rpc/*.d.ts dist/.pikku/addon/rpc/ 2>/dev/null || true) && mkdir -p dist/.pikku/addon/db && cp .pikku/addon/db/pikku-db-meta.gen.json dist/.pikku/addon/db/ && (mkdir -p dist/types && cp types/*.d.ts dist/types/)",
    "pikku": "pikku all",
    "tsc": "tsc --noEmit",
    "test": "cd test && node --import tsx --test 'src/**/*.test.ts'"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.146",
    "@pikku/better-auth": "^0.12.59",
    "kysely": "^0.29.0"
  },
  "dependencies": {
    "@pikkustudio/builder": "workspace:*",
    "@pikku/cli": "^0.12.196",
    "@pikku/kysely": "^0.13.40",
    "vite": "^7.0.0",
    "@pikkustudio/supervisor": "workspace:*",
    "@pikkustudio/design-server": "workspace:*"
  },
  "devDependencies": {
    "@pikku/core": "^0.12.146",
    "@pikku/modelcontextprotocol": "^0.12.19",
    "@types/node": "^24",
    "tsx": "^4.21.0",
    "zod": "^4.3.6",
    "@pikku/better-auth": "^0.12.59",
    "kysely": "^0.29.0",
    "@pikku/deploy": "*"
  },
  "license": "BUSL-1.1",
  "peerDependenciesMeta": {
    "@pikku/better-auth": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  }
}
