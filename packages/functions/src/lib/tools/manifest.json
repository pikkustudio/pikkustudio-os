        "bin": ["bin/java", "bin/javac"]
      },
      "versions": [
        {
          "version": "21.0.12.1",
          "default": true,
          "artifacts": {
            "darwin-arm64": {
              "url": "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_aarch64_mac_hotspot_21.0.12.1_1.tar.gz",
              "sha256": "3623232f33a9c3baadf304480b2535f9a3cba8a58d42ecbb438ba267315d9998",
              "size": 200073404,
              "format": "tar.gz",
              "bin": ["jdk-21.0.12.1+1/Contents/Home/bin/java", "jdk-21.0.12.1+1/Contents/Home/bin/javac"],
              "root": "jdk-21.0.12.1+1/Contents/Home"
            },
            "darwin-x64": {
              "url": "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_x64_mac_hotspot_21.0.12.1_1.tar.gz",
              "sha256": "44db0f08196daf19a47f90d13388b0c943b67663cb537f998fe29e836fa842ce",
              "size": 194316575,
              "format": "tar.gz",
              "bin": ["jdk-21.0.12.1+1/Contents/Home/bin/java", "jdk-21.0.12.1+1/Contents/Home/bin/javac"],
              "root": "jdk-21.0.12.1+1/Contents/Home"
            },
            "linux-arm64": {
              "url": "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_aarch64_linux_hotspot_21.0.12.1_1.tar.gz",
              "sha256": "23e37e026f12f3e706f18938ff611db3032d075b09d0879a25d06718c773e223",
              "size": 205641175,
              "format": "tar.gz",
              "bin": ["jdk-21.0.12.1+1/bin/java", "jdk-21.0.12.1+1/bin/javac"],
              "root": "jdk-21.0.12.1+1"
            },
            "linux-x64": {
              "url": "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_x64_linux_hotspot_21.0.12.1_1.tar.gz",
              "sha256": "ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94",
              "size": 207473347,
              "format": "tar.gz",
              "bin": ["jdk-21.0.12.1+1/bin/java", "jdk-21.0.12.1+1/bin/javac"],
              "root": "jdk-21.0.12.1+1"
            }
          }
        }
      ],
      "env": {"JAVA_HOME": "${root}"},
      "get": {"brew": "brew install openjdk@21", "apt": "sudo apt-get install -y openjdk-21-jdk-headless", "link": "https://adoptium.net/temurin/releases/?version=21"}
    },
    {
      "id": "ghidra",
      "name": "Ghidra",
      "find": {
        "version": "application\\.version=(\\S+)",
        "roots": ["$GHIDRA_INSTALL_DIR", "which:ghidraRun/..", "which:ghidraRun/../libexec", "/opt/homebrew/opt/ghidra/libexec", "/usr/local/opt/ghidra/libexec"],
        "bin": ["support/analyzeHeadless", "ghidraRun"],
        "versionFile": "Ghidra/application.properties",
        "files": {
          "darwin-arm64": ["Ghidra/Features/Decompiler/os/mac_arm_64/decompile"],
          "darwin-x64": ["Ghidra/Features/Decompiler/os/mac_x86_64/decompile"],
          "linux-arm64": ["Ghidra/Features/Decompiler/os/linux_arm_64/decompile"],
          "linux-x64": ["Ghidra/Features/Decompiler/os/linux_x86_64/decompile"]
        }
      },
      "requires": ["jdk@>=21"],
      "versions": [
        {
          "version": "12.1.4",
          "default": true,
          "artifacts": {
            "linux-x64": {
              "url": "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip",
              "sha256": "ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db",
              "size": 569649598,
              "format": "zip",
              "bin": ["ghidra_12.1.4_PUBLIC/support/analyzeHeadless", "ghidra_12.1.4_PUBLIC/ghidraRun"],
              "root": "ghidra_12.1.4_PUBLIC"
            }
          }
        }
      ],
      "env": {"GHIDRA_INSTALL_DIR": "${root}"},
      "get": {
        "link": "https://github.com/NationalSecurityAgency/ghidra/releases",
        "platforms": {
          "darwin-arm64": {"brew": "brew install ghidra"},
          "darwin-x64": {"brew": "brew install ghidra"},
          "linux-arm64": {"note": "Ghidra ships no native decompiler for linux-arm64, so the release zip is unusable here; build the decompiler from source (Ghidra/Features/Decompiler/src/decompile/cpp) into Ghidra/Features/Decompiler/os/linux_arm_64/decompile."}
        }
      }
    }
  ]
}
