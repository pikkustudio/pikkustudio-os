    {
      "id": "ghidra",
      "name": "Ghidra",
      "find": {
        "version": "application\\.version=(\\S+)",
        "roots": ["$GHIDRA_INSTALL_DIR", "which:ghidraRun/..", "which:ghidraRun/../libexec", "/opt/homebrew/opt/ghidra/libexec", "/usr/local/opt/ghidra/libexec"],
        "bin": ["support/analyzeHeadless", "ghidraRun"],
        "versionFile": "Ghidra/application.properties",
        "files": {
          "darwin-arm64": ["Ghidra/Features/Decompiler/os/mac_arm_64/decompile"],
          "darwin-x64": ["Ghidra/Features/Decompiler/os/mac_x86_64/decompile"],
          "linux-arm64": ["Ghidra/Features/Decompiler/os/linux_arm_64/decompile"],
          "linux-x64": ["Ghidra/Features/Decompiler/os/linux_x86_64/decompile"]
        }
      },
      "requires": ["jdk@>=21"],
      "versions": [
        {
          "version": "12.1.4",
          "default": true,
          "artifacts": {
            "linux-x64": {
              "url": "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip",
              "sha256": "ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db",
              "size": 569649598,
              "format": "zip",
              "bin": ["ghidra_12.1.4_PUBLIC/support/analyzeHeadless", "ghidra_12.1.4_PUBLIC/ghidraRun"],
              "root": "ghidra_12.1.4_PUBLIC"
            }
          }
        }
      ],
      "env": {"GHIDRA_INSTALL_DIR": "${root}"},
      "get": {
        "link": "https://github.com/NationalSecurityAgency/ghidra/releases",
        "platforms": {
          "darwin-arm64": {"brew": "brew install ghidra"},
          "darwin-x64": {"brew": "brew install ghidra"},
          "linux-arm64": {"note": "Ghidra ships no native decompiler for linux-arm64, so the release zip is unusable here; build the decompiler from source (Ghidra/Features/Decompiler/src/decompile/cpp) into Ghidra/Features/Decompiler/os/linux_arm_64/decompile."}
        }
      }
    },
