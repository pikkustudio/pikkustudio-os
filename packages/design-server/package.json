{
  "name": "@pikkustudio/design-server",
  "version": "0.12.0",
  "type": "module",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/studio.git",
    "directory": "packages/design-server"
  },
  "bin": {
    "pikku-design-server": "./start.mjs"
  },
  "exports": {
    ".": "./start.mjs"
  },
  "files": [
    "start.mjs",
    "src",
    "messages",
    "seed-scratchpads",
    "project.inlang/settings.json",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "LICENSE"
  ],
  "scripts": {
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --no-emit-readme --silent",
    "prepack": "bun run i18n:compile",
    "tsc": "bun run i18n:compile && tsc --noEmit",
    "dev": "bun run i18n:compile && node start.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.66.0",
    "@vitejs/plugin-react": "^4.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.456.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^6.0.3"
  }
}
