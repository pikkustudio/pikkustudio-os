{
  "name": "@pikkustudio/addon-spindle",
  "version": "0.0.1",
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": [
      "./dist/.pikku/*/index.js",
      "./dist/.pikku/*"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./screens/*": "./src/screens/*.tsx"
  },
  "files": [
    "dist",
    "src/screens"
  ],
  "scripts": {
    "prebuild": "pikku all",
    "build": "tsc && pikku dist",
    "tsc:i18n": "tsc --noEmit -p tsconfig.i18n.json",
    "pikku": "pikku all"
  },
  "peerDependencies": {
    "@pikku/core": "*",
    "react": "*",
    "zod": "^4",
    "kysely": "*",
    "@pikku/react": "*",
    "@pikkustudio/blocks": "*",
    "lucide-react": "*"
  },
  "devDependencies": {
    "@pikku/cli": "*",
    "@pikku/core": "*",
    "@pikku/inspector": "*",
    "@types/node": "*",
    "@types/react": "*",
    "typescript": "^5.7.2",
    "zod": "^4"
  },
  "dependencies": {
    "@pikku/kysely": "^0.13.40"
  },
  "studio": {
    "addon": "spindle",
    "ui": "./src",
    "messages": "./messages/{locale}.json"
  }
}
