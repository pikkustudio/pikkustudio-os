{
  "name": "@pikku/addon-spindle",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": [
      "./dist/.pikku/*/index.js",
      "./dist/.pikku/*"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./screens/*": {
      "types": "./dist/src/screens/*.d.ts",
      "import": "./dist/src/screens/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pikku all",
    "build": "tsc && pikku dist",
    "pikku": "pikku all"
  },
  "peerDependencies": {
    "@pikku/core": "*",
    "react": "*",
    "zod": "^4",
    "kysely": "*",
    "@pikku/react": "*",
    "@pikku/studio-console": "*",
    "lucide-react": "*"
  },
  "devDependencies": {
    "@pikku/cli": "*",
    "@pikku/core": "*",
    "@pikku/inspector": "*",
    "@types/node": "*",
    "@types/react": "*",
    "typescript": "^5.7.2",
    "zod": "^4"
  },
  "dependencies": {
    "@pikku/kysely": "^0.13.34"
  }
}
