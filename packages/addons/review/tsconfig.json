{
  "compilerOptions": {
    "target": "ES2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "#pikku/*.js": [
        "./.pikku/addon/*.ts"
      ],
      "#pikku/*": [
        "./.pikku/addon/*/index.ts"
      ]
    },
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "types/**/*",
    "bin/**/*",
    ".pikku/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".pikku/**/*.d.ts",
    "src/**/*.test.ts"
  ]
}