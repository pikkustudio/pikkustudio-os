{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "tsconfig": "tsconfig.json",
  "srcDirectories": [
    "src"
  ],
  "outDir": ".pikku",
  "clientFiles": {
    "rpcMapDeclarationFile": "apps/addons-ui/src/pikku/rpc-map.gen.d.ts",
    "httpMapDeclarationFile": "apps/addons-ui/src/pikku/http-map.gen.d.ts",
    "fetchFile": "apps/addons-ui/src/pikku/pikku-fetch.gen.ts",
    "rpcWiringsFile": "apps/addons-ui/src/pikku/pikku-rpc.gen.ts"
  },
  "schema": {
    "supportsImportAttributes": true
  },
  "dev": {
    "db": true
  },
  "db": {
    "sqliteExtensions": []
  },
  "content": {
    "uploadUrlPrefix": "/upload",
    "assetUrlPrefix": "/content",
    "sizeLimit": "1gb"
  },
  "scaffold": {
    "pikkuDir": "src/scaffold",
    "rpc": true
  }
}
